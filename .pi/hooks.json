{
    "$schema": "https://raw.githubusercontent.com/gaosh3n/pi-hooks/main/pi-hooks.schema.json",
    "hooks": {
        "tool_call": [
            {
                "matcher": "bash|edit|write",
                "hooks": [
                    {
                        "type": "command",
                        "command": "bash .pi/hooks/tool-call-oxfmt.sh",
                        "statusMessage": "oxfmt: checking proposed write ..."
                    },
                    {
                        "type": "command",
                        "command": "bash .pi/hooks/tool-call-oxlint.sh",
                        "statusMessage": "oxlint: checking proposed write ..."
                    }
                ]
            }
        ]
    }
}
